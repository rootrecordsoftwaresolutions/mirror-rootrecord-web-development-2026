# Copy to credentials.env next to this file OR any parent directory of cloudflare/*/deploy.ps1
# (both primary and licence deploy scripts walk upward until they find credentials.env).
# Never commit credentials.env — it is gitignored at workspace roots when you add it locally.

# --- Cloudflare API (required for deploy.ps1) ---
# Prefer API token (Workers + D1 + edit):
CLOUDFLARE_API_TOKEN=

# Or legacy global API key + account email:
# CLOUDFLARE_EMAIL=
# CLOUDFLARE_GLOBAL_API_KEY=

# Optional but useful in dashboard / some tooling:
CLOUDFLARE_ACCOUNT_ID=

# Must match database_id in cloudflare/rootrecord-primary/wrangler.toml and rootrecord-license/wrangler.toml
D1_DATABASE_ID=

# --- Primary Worker (rootrecord-primary) secrets (deploy.ps1 pipes these to wrangler secret put) ---
# Strong random string, 16+ chars — or leave unset and rely on .deploy-jwt file generated next to deploy.ps1
ROOTRECORD_PRIMARY_JWT_SECRET=

RR_PUSH_ADMIN_SECRET=
RR_USAGE_ADMIN_SECRET=

# Path to Firebase service account JSON file on this machine (not the JSON inline):
FCM_SERVICE_ACCOUNT_JSON_PATH=

STRIPE_SECRET_KEY=
ACCUWEATHER_API_KEY=

# --- Licence Worker (rootrecord-license) ---
ROOTRECORD_LICENSE_JWT_SECRET=
STRIPE_WEBHOOK_SECRET=
