# Copy to credentials.env next to this file OR any parent directory of cloudflare/*/deploy.ps1
# (both primary and licence deploy scripts walk upward until they find credentials.env).
# Never commit credentials.env — it is gitignored at workspace roots when you add it locally.

# --- Cloudflare API (required for deploy.ps1) ---
# Prefer API token (Workers + D1 + edit):
CLOUDFLARE_API_TOKEN=

# Or legacy global API key + account email:
# CLOUDFLARE_EMAIL=
# CLOUDFLARE_GLOBAL_API_KEY=

# Optional but useful in dashboard / some tooling:
CLOUDFLARE_ACCOUNT_ID=

# Must match database_id in cloudflare/rootrecord-primary/wrangler.toml and rootrecord-license/wrangler.toml
D1_DATABASE_ID=

# --- Primary Worker (rootrecord-primary) secrets (deploy.ps1 pipes these to wrangler secret put) ---
# Strong random string, 16+ chars — or leave unset and rely on .deploy-jwt file generated next to deploy.ps1
ROOTRECORD_PRIMARY_JWT_SECRET=

RR_PUSH_ADMIN_SECRET=
RR_USAGE_ADMIN_SECRET=

# Path to Firebase service account JSON file on this machine (not the JSON inline):
FCM_SERVICE_ACCOUNT_JSON_PATH=

STRIPE_SECRET_KEY=
ACCUWEATHER_API_KEY=

# In-app feedback (POST /api/feedback → Discord). deploy.ps1 uploads when set:
# DISCORD_FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Global Updates channel → mobile Settings developer messages (rootrecord-primary cron). deploy.ps1 uploads when set:
# DISCORD_BOT_TOKEN=

# --- Licence Worker (rootrecord-license) ---
ROOTRECORD_LICENSE_JWT_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Cloudflare Pages: rootrecord-website (app-build-request form) ---
# Pages only proxies POST /api/app-build-request → Worker `rootrecord-app-build`.
# Optional: APP_BUILD_WORKER_URL=https://rootrecord-app-build.rootrecord.workers.dev
#
# --- Worker: cloudflare/rootrecord-app-build (Discord / optional DM) ---
# wrangler secret put APP_BUILD_REQUEST_WEBHOOK_URL
# APP_BUILD_REQUEST_WEBHOOK_BEARER=   (optional, generic webhooks)
# APP_BUILD_DISCORD_BOT_TOKEN=
# APP_BUILD_DISCORD_DM_USER_ID=

# --- Cloudflare Web Analytics (optional; one token per hostname for separate dashboard cards) ---
# Dashboard → Web analytics → Add a site → hostname → JS Snippet → copy token only.
# Marketing Pages deploy (Web/main/pages-deploy.ps1): injects from temp copy so tokens are not written into git.
# Product Pages (Mobile/scripts/deploy-product-web-to-pages.ps1): injects into build/ before upload.
# CF_WEB_ANALYTICS_TOKEN_MARKETING=
# CF_WEB_ANALYTICS_TOKEN_WEATHER=
# CF_WEB_ANALYTICS_TOKEN_BUSINESS=
# CF_WEB_ANALYTICS_TOKEN_ACCOUNT=
# CF_WEB_ANALYTICS_TOKEN_TOKEN=
# CF_WEB_ANALYTICS_TOKEN_KILAUEA=

# --- Primary Worker: Solana tooling → Discord (optional) ---
# DISCORD_WEBHOOK_SOLANA_TOOLS=
# Same value as solana-rootrecord-site (Next) SOLANA_SITE_LOG_SECRET (Bearer for POST /api/solana-site/log):
# SOLANA_SITE_LOG_SECRET=
