# Vercel → Project → Settings → Environment Variables
#
# Nothing is required to deploy; the app has safe defaults.
# Add variables only when you need the feature.

# RootRecord portal (account / signup HTML on marketing site). Default: https://rootrecord.info
# NEXT_PUBLIC_ROOTRECORD_PORTAL_ORIGIN=https://rootrecord.info

# RootRecord API (custodial wallet + same Bearer as portal when using email sign-in from Solana Tools):
# NEXT_PUBLIC_ROOTRECORD_API_BASE=https://api.rootrecord.info

# NEXT_PUBLIC_RPC_URL=https://…   (https:// added automatically if omitted)
# NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
# (hostname only is OK, e.g. your-app.vercel.app — https:// is added automatically)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=   (optional; Search Console “HTML tag” verification string for metadata)
# NEXT_PUBLIC_FEE_WALLET=   (pubkey that receives create/tools/Raydium/bulk **platform SOL fees** — use your **treasury**, not the ops/dev wallet from Purpose/Tokenomics.)
# Example (default RRTT treasury on mainnet docs): 3QG6gVk3fdimzQaKX9zf7J6kCs5DRLKg1RNea3VBosDJ
# If FEE_WALLET equals NEXT_PUBLIC_ECOSYSTEM_SOLSCAN_DEVELOPER (or its default), the app sends fees to the treasury above instead.
# NEXT_PUBLIC_CREATE_FEE_SOL=0.025
# NEXT_PUBLIC_ACTION_FEE_SOL=0.01
# NEXT_PUBLIC_REFERRAL_SHARE_BPS=1000   (optional; basis points of each platform fee to eligible ?ref= wallet in same tx; default 1000 = 10%. Set 0 to disable.)
# NEXT_PUBLIC_LAUNCH_FEE_SOL=0.05   (Raydium pool launch tool; first tx before pool creation)
# NEXT_PUBLIC_ADD_LIQUIDITY_FEE_SOL=0.005   (add liquidity to existing CPMM pool; first tx before deposit)
# NEXT_PUBLIC_REMOVE_LIQUIDITY_FEE_SOL=0.005   (remove liquidity / burn LP; first tx before withdraw)
# NEXT_PUBLIC_LAUNCH_USDC_MINT=     (optional; defaults to mainnet/devnet USDC mint for “pair with USDC”)
# NEXT_PUBLIC_BULK_FEE_PER_100_SOL=0.01   (bulk SOL page; per 100 recipients, rounded up)
# NEXT_PUBLIC_PINATA_GATEWAY=gateway.pinata.cloud
# (hostname only, e.g. mygateway.mypinata.cloud — no https://)

# Server-only (Vercel → same name, no NEXT_PUBLIC_ prefix):
# PINATA_JWT=
#
# Action log + “My Actions” read API → Cloudflare Worker (D1 `solana_site` + `solana_site_challenges`). Omit to skip (no-op).
# SOLANA_SITE_LOG_URL=https://<rootrecord-primary-host>/api/solana-site/log
# SOLANA_SITE_LOG_SECRET=<same value as Worker secret SOLANA_SITE_LOG_SECRET>
#
# New-mint Discord: when SOLANA_SITE_LOG_URL + SOLANA_SITE_LOG_SECRET are set, POST /api/solana-site/token-discord-notify
# is proxied to the same Worker host (same Bearer). Set the webhook on the Worker:
#   wrangler secret put DISCORD_TOKEN_CREATE_WEBHOOK_URL
# Optional fallback (local / preview without Worker): set DISCORD_TOKEN_CREATE_WEBHOOK_URL here on Vercel instead.
# DISCORD_TOKEN_CREATE_WEBHOOK_URL=https://discord.com/api/webhooks/…
#
# OTC treasury + auto Raydium CPMM deposit after finalize (server-side; treasury keypair required elsewhere):
# ECOSYSTEM_OTC_TREASURY_PRIVATE_KEY=   (or ECOSYSTEM_OTC_TREASURY_SECRET_KEY)
#
# Raydium CPMM **pool id** = pool state account from Raydium (Liquidity page / API). This is NOT the SPL mint.
# Wrong value: using NEXT_PUBLIC_ECOSYSTEM_TOKEN_MINT — that mint is the RRTT token mint, not a pool address.
# Treasury auto-LP uses separate pools for SOL (WSOL) vs USDC; each buy deposits into the pool matching the quote paid.
# ECOSYSTEM_OTC_CPMM_POOL_ID_SOL=   (server; WSOL pair — falls back to ECOSYSTEM_OTC_CPMM_POOL_ID if unset)
# ECOSYSTEM_OTC_CPMM_POOL_ID_USDC=  (server; USDC pair — falls back to legacy ECOSYSTEM_OTC_CPMM_POOL_ID if unset)
# NEXT_PUBLIC_ECOSYSTEM_OTC_CPMM_POOL_ID_SOL=   (optional; ecosystem page Solscan link)
# NEXT_PUBLIC_ECOSYSTEM_OTC_CPMM_POOL_ID_USDC=  (optional; overrides default USDC/RRTT CPMM pool id in ecosystemOtcConstants)
# NEXT_PUBLIC_ECOSYSTEM_OTC_CPMM_POOL_ID_JUP=   (optional; JUP/RRTT pool — ecosystem Solscan link; defaults in code)
# NEXT_PUBLIC_ECOSYSTEM_OTC_CPMM_POOL_ID_RAY=   (optional; RAY/RRTT pool — ecosystem Solscan link; defaults in code)
# Legacy single pool (both rails if split envs omitted — only valid when one pool somehow matches both quotes):
# ECOSYSTEM_OTC_CPMM_POOL_ID=
# NEXT_PUBLIC_ECOSYSTEM_OTC_CPMM_POOL_ID=   (optional; treated as SOL/WSOL pool id for links + legacy fallback)
#
# Ecosystem /tokenomics Solscan labels (optional; defaults match production RRTT deployment):
# NEXT_PUBLIC_ECOSYSTEM_SOLSCAN_TREASURY=
# NEXT_PUBLIC_ECOSYSTEM_SOLSCAN_DEVELOPER=
#
# If solana.rootrecord.info must route /api/* through Cloudflare rootrecord-primary Worker, set on that Worker:
#   wrangler secret put SOLANA_TOOLS_API_FORWARD_URL
# Value: https://<your-project>.vercel.app   (no trailing slash). Not needed when DNS sends the hostname straight to Vercel.
